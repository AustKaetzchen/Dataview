  title: "Information & Controls",
  defaultTab: "controls",

  tabs: [
    {
      id: "controls",
      label: "Controls",
      icon: "tune",
      type: "controls",
      title: "Active Modes & Camera Controls",
      description: "Live summary of active rendering layers, projection state, and 3D camera shortcuts.",
      shortcutsHeader: "Navigation Shortcuts",
      shortcuts: [
        {
          key: "Ctrl + Drag",
          action: "Pitch & rotate 3D camera (smooth linear tilt)",
        },
        {
          key: "Right-click Drag",
          action: "Pitch & rotate 3D camera",
        },
        {
          key: "Left Drag",
          action: "Pan map view smoothly across all projections",
        },
        {
          key: "Scroll Wheel",
          action: "Smooth zoom in & out",
        },
        {
          key: "Double Click",
          action: "Reset camera center, pitch, and zoom",
        },
        {
          key: "Hover",
          action: "Inspect pixel coordinates & scalar values",
        },
      ],
    },
    {
      id: "about",
      label: "About",
      icon: "info",
      type: "content",
      title: "About GeoPNG Dataview",
      badge: "v2.4 Pro",
      sections: [
        {
          heading: "Overview",
          text: "GeoPNG Dataview is a high-performance geospatial raster visualizer powered by deck.gl and WebGL. It delivers real-time 2D/3D rendering of high-resolution single-band and multi-temporal geospatial datasets directly in the browser with zero server latency.",
        },
        {
          heading: "Projections & 3D Terrain",
          text: "Full support for Web Mercator, Equirectangular, Equal Earth, and 3D Interactive Globe projections. Render extruded 3D terrain needle columns, proportional equal-area circles, and multi-country polygon quantile binning on demand.",
        },
        {
          heading: "Analytical Engine",
          text: "Integrated ECharts analytical distributions, interactive percentile breakpoint adjustment, and instant multi-country statistical mask calculations.",
        },
      ],
    },
    {
      id: "policy",
      label: "Policy",
      icon: "gavel",
      type: "content",
      title: "Data Policy & Terms",
      sections: [
        {
          heading: "Data Usage & Client Privacy",
          text: "All raster decoding, color mapping, histogram calculations, and country mask operations are processed locally in your client browser memory via Web Workers and GPU shaders. No uploaded imagery or sensitive raster data is transmitted to external servers.",
        },
        {
          heading: "Map Tiles & Boundaries",
          text: "Basemap imagery is served via Esri ArcGIS World Imagery and Dark Canvas services. Country administrative boundaries are derived from Natural Earth 1:50m cultural datasets under public domain licensing.",
        },
        {
          heading: "Attribution & Citation",
          text: "When citing or publishing maps produced with GeoPNG Dataview, please attribute GeoPNG Dataview, Natural Earth, and applicable source raster authors.",
        },
      ],
    },
  ],
}
