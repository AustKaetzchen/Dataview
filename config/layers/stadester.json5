{
    name: "Stadestér (Cities)",
    root_folders: {
        l_stad: "D:/Project 1436 - Dataview/data/stadester"
    },
    "stadester_1.0": {
        name: "Stadestér 1.0",
        type: "vector.points",
        unit: "Urban Population",
        icon: "location_city",
        description: [
            "### Stadestér 1.0",
            "A global historical database of 41,000+ cities and urban settlements from 3000BC to the present.",
            "Includes estimated urban populations, areas, and densities compiled from Chandler, Bairoch/Buringh, de Vries, and modern census sources."
        ],
        filepath: "${l_stad}/stadester_1.0.json",
        permissions: ["default"],
        legend: {
            colourscheme: "Plasma",
            type: "pseudo-log",
            modes: [
                "population",
                "growth",
                "area",
                "density",
                "continent"
            ]
        }
    },
    "stadester_1.1": {
        name: "Stadestér 1.1",
        type: "vector.points",
        unit: "Urban Population",
        icon: "location_city",
        description: [
            "### Stadestér 1.1",
            "Updated and recalibrated global urban dataset spanning 3300BC to 2025AD with 34,400+ settlements.",
            "Features harmonised coordinates, historical aliases, area measurements, and annualised growth calculations."
        ],
        filepath: "${l_stad}/stadester_1.1.json",
        permissions: ["default"],
        legend: {
            colourscheme: "Plasma",
            type: "pseudo-log",
            modes: [
                "population",
                "growth",
                "area",
                "density",
                "continent"
            ]
        }
    }
}